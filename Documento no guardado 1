YAML

dependencies:
  flutter:
    sdk: flutter
  
  # Lógica y reglas de ajedrez
  chess: ^0.8.0
  # Tablero visual interactivo
  flutter_chess_board: ^1.0.1
  # Peticiones HTTP a Gemini API
  http: ^1.2.0
  # Voz (Text-to-Speech)
  flutter_tts: ^4.0.2
Dart
import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:flutter_chess_board/flutter_chess_board.dart';
import 'package:flutter_tts/flutter_tts.dart';
import 'package:http/http.dart' as http;

void main() {
  runApp(const ChessTutorApp());
}

class ChessTutorApp extends StatelessWidget {
  const ChessTutorApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Ajedrez con Maestro IA',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.deepPurple),
        useMaterial3: true,
      ),
      home: const ChessGamePage(),
    );
  }
}

class ChessGamePage extends StatefulWidget {
  const ChessGamePage({super.key});

  @override
  State<ChessGamePage> createState() => _ChessGamePageState();
}

class _ChessGamePageState extends State<ChessGamePage> {
  // Controlador del tablero
  final ChessBoardController _boardController = ChessBoardController();

  // Motor de voz
  final FlutterTts _tts = FlutterTts();

  // Configuración de Gemini API
  // ⚠️ Reemplaza con tu clave de Google AI Studio:
  final String _geminiApiKey = 'TU_GEMINI_API_KEY_AQUI';

  // Personalidad del Maestro
  String _personality = 'amigable';
  String _level = 'principiante';

  // Estado del maestro
  String _masterComment =
      "¡Hola! Soy tu Maestro de Ajedrez. Haz tu primer movimiento.";
  bool _isLoading = false;

  @override
  void initState() {
    super.initState();
    _initTts();
  }

  // Configuración inicial de la voz
  Future<void> _initTts() async {
    await _tts.setLanguage("es-ES"); // Configurar idioma a español
    await _tts.setPitch(0.9); // Tono de voz más grave/maduro
    await _tts.setSpeechRate(0.5); // Velocidad normal de habla
  }

  // Hacer hablar al maestro
  Future<void> _speak(String text) async {
    await _tts.stop();
    await _tts.speak(text);
  }

  // System Prompts según personalidad
  String _getSystemPrompt() {
    String baseRole =
        "Eres un Maestro Gran Maestro de Ajedrez enseñando a un alumno de nivel $_level. "
        "Analiza el estado del juego dado en notación FEN. Se breve, máximo 2 o 3 frases. "
        "Explica en español directo y didáctico.";

    switch (_personality) {
      case 'estricto':
        return "$baseRole Actúa de forma disciplinada, exigente y severa con los errores, exigiendo máxima precisión.";
      case 'gracioso':
        return "$baseRole Usa metáforas divertidas, un toque de humor sarcástico y amigable para enseñar.";
      case 'amigable':
      default:
        return "$baseRole Sé muy paciente, motivador, cálido y enfocado en resaltar los aspectos pedagógicos positivos.";
    }
  }

  // Llamada a la API de Gemini
  Future<void> _analyzePositionWithGemini(String fen) async {
    if (_geminiApiKey == 'TU_GEMINI_API_KEY_AQUI') {
      setState(() {
        _masterComment = "⚠️ Recuerda configurar tu Gemini API Key en el código.";
      });
      return;
    }

    setState(() {
      _isLoading = true;
      _masterComment = "El maestro está analizando el tablero...";
    });

    final url = Uri.parse(
      'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=$_geminiApiKey',
    );

    try {
      final response = await http.post(
        url,
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          "system_instruction": {
            "parts": [
              {"text": _getSystemPrompt()}
            ]
          },
          "contents": [
            {
              "parts": [
                {
                  "text":
                      "El usuario acaba de mover. El estado actual de la partida en FEN es: $fen. Comenta la posición en voz alta para tu alumno."
                }
              ]
            }
          ]
        }),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        final reply = data['candidates']?[0]?['content']?['parts']?[0]?['text'] ??
            "Interesante movimiento. Continuemos.";

        setState(() {
          _masterComment = reply;
          _isLoading = false;
        });

        // Narrar respuesta con voz
        _speak(reply);
      } else {
        setState(() {
          _masterComment = "El maestro dudó un segundo (Error de API).";
          _isLoading = false;
        });
      }
    } catch (e) {
      setState(() {
        _masterComment = "Error de conexión con el maestro.";
        _isLoading = false;
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Maestro de Ajedrez IA'),
        centerTitle: true,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          children: [
            // --- PANEL DE PERSONALIDAD DEL MAESTRO ---
            Card(
              elevation: 2,
              child: Padding(
                padding: const EdgeInsets.all(12.0),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceAround,
                  children: [
                    // Estilo / Personalidad
                    DropdownButton<String>(
                      value: _personality,
                      items: const [
                        DropdownMenuItem(value: 'amigable', child: Text('😊 Paciente')),
                        DropdownMenuItem(value: 'estricto', child: Text('🛑 Estricto')),
                        DropdownMenuItem(value: 'gracioso', child: Text('🎭 Divertido')),
                      ],
                      onChanged: (val) => setState(() => _personality = val!),
                    ),
                    // Nivel del alumno
                    DropdownButton<String>(
                      value: _level,
                      items: const [
                        DropdownMenuItem(value: 'principiante', child: Text('Principiante')),
                        DropdownMenuItem(value: 'intermedio', child: Text('Intermedio')),
                        DropdownMenuItem(value: 'avanzado', child: Text('Avanzado')),
                      ],
                      onChanged: (val) => setState(() => _level = val!),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 12),

            // --- TABLERO VISUAL Y REGLAS LEGALES ---
            Center(
              child: ChessBoard(
                controller: _boardController,
                boardColor: BoardColor.brown,
                boardOrientation: PlayerColor.white,
                onMove: () {
                  // Se activa automáticamente cada vez que mueves una pieza legalmente
                  final currentFen = _boardController.getFen();
                  _analyzePositionWithGemini(currentFen);
                },
              ),
            ),
            const SizedBox(height: 16),

            // --- COMENTARIOS Y VOZ DEL MAESTRO ---
            Card(
              color: Colors.deepPurple.shade50,
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(16),
              ),
              child: Padding(
                padding: const EdgeInsets.all(16.0),
                child: Column(
                  children: [
                    Row(
                      children: [
                        const CircleAvatar(
                          child: Icon(Icons.psychology),
                        ),
                        const SizedBox(width: 12),
                        Text(
                          "Maestro (${_personality.toUpperCase()})",
                          style: const TextStyle(fontWeight: FontWeight.bold),
                        ),
                        const Spacer(),
                        if (_isLoading)
                          const SizedBox(
                            width: 20,
                            height: 20,
                            child: CircularProgressIndicator(strokeWidth: 2),
                          )
                        else
                          IconButton(
                            icon: const Icon(Icons.volume_up),
                            onPressed: () => _speak(_masterComment),
                          )
                      ],
                    ),
                    const Divider(),
                    Text(
                      _masterComment,
                      style: const TextStyle(fontSize: 16, fontStyle: FontStyle.italic),
                      textAlign: TextAlign.center,
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
